# ---------------------------------------------------------------------------
# Library Management System - Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---
DATABASE_URL=postgresql+psycopg://lms_user:lms_password@db:5432/lms_db

# --- Security ---
# Generate a strong secret:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# --- Business rules ---
LOAN_PERIOD_DAYS=20
FINE_PER_DAY=10
MAX_BOOKS_PER_STUDENT=5

# --- Notifications ---
SMS_PROVIDER=mock           # mock | log (real gateway can be added later)
SMS_API_KEY=
SMS_SENDER_ID=LMS

# --- App ---
APP_NAME=Library Management System
ENVIRONMENT=development
DEBUG=true

# --- Seed admin account (used only by `python -m app.seed`) ---
SEED_ADMIN_EMAIL=admin@library.com
SEED_ADMIN_PASSWORD=Admin@123

# --- Docker Compose ---
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password
POSTGRES_DB=lms_db
BACKEND_PORT=8000
FRONTEND_PORT=3000
RUN_SEED=true
VITE_API_URL=http://localhost:8000
